<?xml version="1.0" encoding="UTF-8"?>
<!--
  Connect IQ manifest. The application `id` below is a placeholder — if you
  create the project with the VS Code "Connect IQ: New Project" generator it
  will mint a real one; otherwise this 32-hex id is valid to build/sideload.
  Edit the <iq:products> list to match YOUR exact watch (see README).
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application
      entry="StrengthApp"
      id="a1b2c3d4e5f64758a9b0c1d2e3f40516"
      launcherIcon="@Drawables.LauncherIcon"
      minSdkVersion="3.2.0"
      name="@Strings.AppName"
      type="watch-app"
      version="1.0.0">
    <iq:products>
      <!-- Forerunner 265 (46 mm) and 265S (42 mm). Add more ids here if needed. -->
      <iq:product id="fr265"/>
      <iq:product id="fr265s"/>
    </iq:products>
    <iq:permissions>
      <iq:uses-permission id="Fit"/>
      <iq:uses-permission id="FitContributor"/>
    </iq:permissions>
    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
